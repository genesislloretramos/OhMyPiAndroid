<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.omp.terminal.TerminalView
            android:id="@+id/terminalView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!--
          The chat, from whichever origin is serving it: Apache inside the Debian once there is
          one, and this app's own loopback server until then. It sits beside the terminal in the
          same column and exactly one of the two is visible, because a phone showing both at once
          is a phone showing two things that both want Back.

          Gone rather than invisible: a WebView that is not on screen still runs its timers unless
          the Activity pauses it, and ChatView.onPause is driven by the Activity's own lifecycle.
        -->
        <com.omp.terminal.ChatView
            android:id="@+id/chatView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <com.omp.terminal.ExtraKeysView
            android:id="@+id/extraKeys"
            android:layout_width="match_parent"
            android:layout_height="44dp" />
    </LinearLayout>

    <!-- Invisible IME sink, kept last so it sits on top of the terminal and can take focus.
         showSoftInputOnFocus is set in code: it is a TextView setter, not a public XML attribute. -->
    <EditText
        android:id="@+id/imeInput"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:alpha="0"
        android:cursorVisible="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:importantForAutofill="no"
        android:inputType="none" />
</FrameLayout>
