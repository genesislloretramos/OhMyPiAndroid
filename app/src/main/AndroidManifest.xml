<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Browse shared storage; grantable at runtime by the user, see grant-storage. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- curl -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- API 30+ package visibility, without it pm list packages shows almost nothing -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- am force-stop -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- The chat server: a foreground service that holds a loopback socket open. FOREGROUND_SERVICE
         alone, because the type is specialUse and not dataSync — see the <service> below. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Without this the notification a foreground service is required to show is not shown on
         API 33+, which would leave the user with a service they cannot see and cannot stop. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      extractNativeLibs is what puts proot on the device at all. The APK carries a native helper
      under `lib/<abi>/` for every ABI this app claims, and the package manager copies those entries
      out of the APK at install time into `applicationInfo.nativeLibraryDir`. That directory is the
      one place Android still lets an app's own uid `exec` a file: since Android 10,
      `execute_no_trans` on an `app_data_file` is denied to any app with `targetSdkVersion >= 29`.
      Without this attribute the entries are mapped straight out of the APK and never reach the
      filesystem, which leaves a compressed member of a ZIP where the kernel needs a file.

      It is duplicated as `packaging { jniLibs { useLegacyPackaging = true } }` in
      `app/build.gradle.kts`, because Google's documentation says that DSL option replaces this
      manifest attribute and the DSL is what AGP acts on. See
      <https://developer.android.com/ndk/guides/wrap-script> and
      <https://developer.android.com/about/versions/10/behavior-changes-10>.

      The 337 MB Debian rootfs does NOT belong in that directory. It is created and owned by the
      package manager and is not writable by the app, and the only things ever placed in it are the
      `lib*.so` files that were in the APK. The rootfs and the agent binary only need to be
      readable, which ordinary app storage provides. What is vendored under `jniLibs`, and under
      which licence with which source offer, is written out in README.md.
    -->
    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:hardwareAccelerated="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|density|uiMode|navigation"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustNothing|stateAlwaysVisible">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The host. Not exported: nothing outside this app has any business starting it, and the
          only door into it is a browser on this device, which reaches it over loopback with the
          install's own token. The Activity is what starts it; the notification's Stop action is
          what ends it.

          The type is specialUse and not dataSync, and the reason is the cap: Android 14 allows a
          dataSync foreground service about six hours in a rolling day and then stops it, which for
          a server that is meant to be up whenever the app is open would be a feature that is off
          for most of every day. specialUse has no such cap. It is also the type a store review
          asks you to justify — which is a cost this app does not pay, because it is sideloaded and
          has never been on a store. The subtype below is the justification, in the plainest terms
          available, because a reader in six months will otherwise "tidy" this back to dataSync and
          break the thing.
        -->
        <service
            android:name=".ChatService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A local HTTP server bound to this device's loopback interface, serving this app's own chat UI to a browser on this phone" />
        </service>
    </application>
</manifest>
